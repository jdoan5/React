# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp

# Claude Code local config — launch.json hardcodes machine-specific absolute
# paths (nvm bin, project dirs), so it isn't portable across clones
.claude/

# Dependencies & build output
# (each project also carries its own .gitignore)
node_modules/
dist/
build/

# Secrets — never commit real keys; .env.example is the tracked template
.env
.env.*
!.env.example

# Vercel
.vercel
