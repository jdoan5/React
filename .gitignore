# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp

# Claude Code local config — launch.json hardcodes machine-specific absolute
# paths (nvm bin, project dirs), so it isn't portable across clones
.claude/

# Dependencies & build output
# (each project also carries its own .gitignore)
node_modules/
dist/
build/

# Secrets — never commit real keys; .env.example is the tracked template
.env
.env.*
!.env.example

# Vercel
.vercel

# macOS / iCloud Drive sync-conflict copies: "name 2", "name 2.ext", "name 10.ext".
# This repo lives in an iCloud-synced folder. When iCloud resolves a conflict it
# keeps both versions and suffixes one with " 2" — and the `node_modules/` rule
# above does not match "node_modules 2", which is how 4,026 of them reached main.
* [0-9]
* [0-9].*
* [0-9][0-9]
* [0-9][0-9].*
